# Copy to .env and adjust. `make` loads it for both the API and the web app.
# Every variable is optional; the values shown are the defaults.

# ---- API ----
# SQLAlchemy async URL. Defaults to backend/data/platform.db.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/platform.db
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000

# DSM regulation used when no policy has been activated from the UI.
# Must match a YAML file in backend/data/policies.
DSM_POLICY=cerc_dsm_2024_draft

# Total exposure (VaR + expected DSM penalty) that raises a risk alert, in INR.
RISK_VAR_THRESHOLD_INR=500000

# Base LP weights: DSM penalty (lambda1) and forecast uncertainty (lambda2).
# Each strategy scales them by (1 - risk_tolerance).
SOLVER_LAMBDA1_BASE=2.0
SOLVER_LAMBDA2_BASE=1.5

# Verify TLS certificates when scraping the exchange and weather APIs.
# Behind a TLS-intercepting proxy, prefer REQUESTS_CA_BUNDLE over disabling this.
HTTP_TLS_STRICT=true
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca.pem

# ---- Nightly pipeline (scrape, enrich, score, retrain) ----
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_CRON_HOUR=1
SCHEDULER_CRON_MINUTE=10
SCHEDULER_RUN_ON_STARTUP=false
SCHEDULER_SCRAPE_LOOKBACK_DAYS=1
SCHEDULER_ENRICHMENT_ENABLED=true
SCHEDULER_RETRAIN_ENABLED=true
SCHEDULER_TRAIN_SEGMENTS=DAM,RTM,TAM
SCHEDULER_TAM_REGION=NR
# Yesterday's forecast MAPE (%) above which a segment is retrained regardless.
FEEDBACK_MAPE_THRESHOLD=15.0

# ---- Web app ----
# Where the Next.js server proxies /api requests.
BACKEND_URL=http://localhost:8000

# ---- Sign-in (see docs/AUTH.md) ----
# Shared by both services: the web app signs a 60 second token with it on every API call,
# and the API rejects calls without one. Unset, the API records every caller as "local".
# Generate with: openssl rand -hex 32
# API_AUTH_SECRET=

# Encrypts session cookies. Required in production; `next dev` falls back to a fixed value.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Each provider appears on the sign-in page once its client id is set.
# `next dev` also offers a name-only local sign-in.
# AUTH_VERCEL_ID=
# AUTH_VERCEL_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Accounts that may sign in: ids such as github:desk-north, "vercel:*" for every account
# the Vercel app admits, or "*". Empty admits nobody.
# AUTH_ALLOWED_USERS=vercel:*

# Not needed on Vercel. Elsewhere, set AUTH_TRUST_HOST=true behind a reverse proxy you
# control, or AUTH_URL to the public origin.
# AUTH_TRUST_HOST=true
# Lets preview deployments sign in through production's GitHub callback.
# AUTH_REDIRECT_PROXY_URL=https://<production-domain>/api/auth
